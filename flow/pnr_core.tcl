# pnr_core.tcl - SCL C1D core-block place & route for pwm8_spi_core (floorplan -> pdn -> place -> cts -> route)
# Based on SCL's scripts_template/*.tcl. Specific to pwm8_spi:
#   - constraints come from the project SDC (two clocks, CLK and SCLK) instead of one create_clock
#   - STOP_AFTER=place stops after placement (Lesson 6); unset or "route" runs everything (Lesson 7)
# Run inside the OpenLane container (see flow/run_pnr.sh). Inputs via environment:
#   C1D CORE_LEF NETLIST DESIGN SDC OUT PINS_TCL DIE_W DIE_H CORE_M VDD_Y VSS_Y PL_DENSITY MIN_GAP
#   PNR_CORNER BLOCKAGES STOP_AFTER RSZ_ARGS SKIP_REPAIR

set C1D   $::env(C1D)
set OUT   $::env(OUT)
set STOP  [expr {[info exists ::env(STOP_AFTER)] ? $::env(STOP_AFTER) : "route"}]
file mkdir $OUT
# THREADS (default 8): without this the detailed router runs on one core
set_thread_count [expr {[info exists ::env(THREADS)] ? $::env(THREADS) : 8}]

# Short electrical-rule summary (slew / cap / fanout violators) for the log
proc drv_summary {tag} {
    global OUT
    set f $OUT/drv_$tag.rpt
    report_check_types -max_slew -max_capacitance -max_fanout -violators > $f
    set fh [open $f]; set n [regexp -all {VIOLATED} [read $fh]]; close $fh
    puts "FLOW: DRV violations $tag = $n ($f)"
}

# ---- Libraries ------------------------------------------------------------------------------
# PNR_LIB overrides the liberty used for sizing (e.g. a relaxed-slew copy for a first repair pass)
set pnr_lib [expr {[info exists ::env(PNR_LIB)] && $::env(PNR_LIB) ne "" ? $::env(PNR_LIB) : "$C1D/lib/c1d_core_$::env(PNR_CORNER).lib"}]
puts "FLOW: liberty $pnr_lib"
read_liberty $pnr_lib
read_lef [expr {[info exists ::env(TECH_LEF)] ? $::env(TECH_LEF) : "$C1D/lef/tech_c1d.lef"}]
read_lef $::env(CORE_LEF)
read_verilog $::env(NETLIST)
link_design $::env(DESIGN)
read_sdc $::env(SDC)                                     ;# Lesson 3 constraints (CLK, SCLK, I/O, CDC)

# ---- Floorplan (SCL: remove alternating rows) ------------------------------------------------
set W $::env(DIE_W); set H $::env(DIE_H); set M $::env(CORE_M)
initialize_floorplan -site CORE -die_area "0 0 $W $H" -core_area "$M $M [expr $W-$M] [expr $H-$M]"
set count 0
foreach row [[ord::get_db_block] getRows] {
    if { [expr $count % 2] != 0 } { odb::dbRow_destroy $row }
    incr count
}
puts "FLOW: rows kept = [llength [[ord::get_db_block] getRows]]"
make_tracks metal1 -x_offset 0.0 -x_pitch 4.0 -y_offset 0.0 -y_pitch 4.0
make_tracks metal2 -x_offset 0.0 -x_pitch 4.2 -y_offset 0.0 -y_pitch 4.2
if {[[[ord::get_db] getTech] findLayer metal3] ne "NULL"} { make_tracks metal3 -x_offset 0.0 -x_pitch 4.0 -y_offset 0.0 -y_pitch 4.0 }

# ---- Pins facing their frame pads (generated by flow/gen_pins.py) ---------------------------
source $::env(PINS_TCL)

# ---- Power: ring + followpins + one M1 stripe per net to the W/E die edges ------------------
add_global_connection -net VDD -pin_pattern VDD -power
add_global_connection -net VSS -pin_pattern VSS -ground
global_connect
set_voltage_domain -name CORE -power VDD -ground VSS
define_pdn_grid -name Core -voltage_domain CORE
add_pdn_ring -grid Core -layers {metal1 metal2} -widths {12 12} -spacings {6 6} -core_offsets {20 20}
add_pdn_stripe -grid Core -layer metal1 -width 9.0 -followpins -extend_to_core_ring
add_pdn_connect -grid Core -layers {metal1 metal2}
pdngen

# Edge stripes: pdngen drops -nets stripes here, so add them with OpenDB. Each is a 20 um M1 wire
# at a row-gap centre from die edge to die edge, with VIA12 arrays where it crosses its own ring leg.
proc add_edge_stripe {netname yc} {
    set block [ord::get_db_block]
    set tech  [[ord::get_db] getTech]
    set dbu   [$block getDbUnitsPerMicron]
    set m1    [$tech findLayer metal1]
    set via   [$tech findVia VIA12]
    set net   [$block findNet $netname]
    set die   [$block getDieArea]
    set y1 [expr round(($yc - 10.0) * $dbu)]; set y2 [expr round(($yc + 10.0) * $dbu)]
    set sw [odb::dbSWire_create $net ROUTED]
    odb::dbSBox_create $sw $m1 [$die xMin] $y1 [$die xMax] $y2 STRIPE
    set nvia 0
    foreach w [$net getSWires] {
        foreach b [$w getWires] {
            if {[$b isVia]} continue
            if {[$b getWireShapeType] != "RING" || [[$b getTechLayer] getName] != "metal2"} continue
            if {[$b yMin] > $y1 || [$b yMax] < $y2} continue
            for {set x [expr [$b xMin] + 2500]} {$x <= [$b xMax] - 2500} {incr x 3000} {
                for {set y [expr $y1 + 2500]} {$y <= $y2 - 2500} {incr y 3000} {
                    odb::dbSBox_create $sw $via $x $y STRIPE; incr nvia
                }
            }
        }
    }
    puts "FLOW: edge stripe $netname at y=$yc, $nvia vias"
}
add_edge_stripe VDD $::env(VDD_Y)
add_edge_stripe VSS $::env(VSS_Y)
write_def $OUT/1_pdn.def

# ---- Placement --------------------------------------------------------------------------------
set max_disp [expr {[info exists ::env(MAX_DISP)] && $::env(MAX_DISP) ne "" ? $::env(MAX_DISP) : {500 200}}]   ;# legaliser reach (sites, rows)
global_placement -density $::env(PL_DENSITY)

# Fix max-slew / max-cap with the resizer (not in SCL's template; 1.2 um cells + long wires
# otherwise give slews far above the 2.5 ns liberty limit). DELBUF is a delay cell, not a driver.
set_wire_rc -signal -layer metal2
set_wire_rc -clock  -layer metal2
# Cells that fail the routing-LEF audit (syn/dont_use.txt, no DRC-legal via site on a pin) + delay/filler cells
set du {DELBUF FILLER1 FILLER2 FILLER3 FILLER4 FILLER5}
if {[info exists ::env(DONT_USE_FILE)] && [file exists $::env(DONT_USE_FILE)]} {
    set fh [open $::env(DONT_USE_FILE)]; foreach l [split [read $fh] "\n"] { if {$l ne "" && ![string match "#*" $l]} { lappend du $l } }; close $fh
}
puts "FLOW: dont_use $du"
set_dont_use $du
estimate_parasitics -placement
drv_summary before_repair
# pwm8_spi: the plain call runs away (OOM) because the reset/clock nets are huge; RSZ_ARGS lets a run pass options.
set rsz_args [expr {[info exists ::env(RSZ_ARGS)] ? $::env(RSZ_ARGS) : ""}]
if {[info exists ::env(PRE_RSZ_TCL)]} { source $::env(PRE_RSZ_TCL) }   ;# optional hook (debug settings)
if {[info exists ::env(SKIP_REPAIR)] && $::env(SKIP_REPAIR) == "1"} {
    puts "FLOW: repair_design SKIPPED (SKIP_REPAIR=1): slew/cap/fanout violations stay in the design"
} else {
    puts "FLOW: repair_design $rsz_args"
    repair_design {*}$rsz_args
}
estimate_parasitics -placement
drv_summary after_repair
detailed_placement -max_displacement $max_disp
check_placement -verbose
report_design_area
write_def $OUT/2_place.def
if {$STOP == "place"} {
    puts "FLOW: stopped after placement (STOP_AFTER=place), wrote $OUT/2_place.def"
    exit
}

# ---- Clock trees for CLK and SCLK (CDRI01 clock drivers) --------------------------------------
set_cmd_units -time ns -capacitance pF -resistance kOhm -voltage V -current mA
clock_tree_synthesis -root_buf CDRI01 -buf_list "CDRI01" -sink_clustering_enable   ;# SCL template used INVR01
set_propagated_clock [all_clocks]
repair_clock_nets
detailed_placement -max_displacement $max_disp

# Abut cells closer than MIN_GAP (left shifts only, so no overlaps). SCL's fillers only bridge
# boron in part of the row height, so any 0 < gap < 1.5 um leaves boron notches (rule 5.7.1) and
# FILLER5 boron intrudes on neighbour ndiff (5.4.1/5.5.1). No fillers are used.
proc abut_rows {min_gap_um} {
    set block [ord::get_db_block]
    set dbu [$block getDbUnitsPerMicron]
    set min_gap [expr round($min_gap_um * $dbu)]
    set moved 0
    foreach row [$block getRows] {
        set ry [[$row getBBox] yMin]
        set cells {}
        foreach inst [$block getInsts] {
            if {[[$inst getMaster] getType] != "CORE"} continue
            set loc [$inst getLocation]
            if {[lindex $loc 1] == $ry} { lappend cells [list [lindex $loc 0] $inst] }
        }
        set prev_end ""
        foreach pair [lsort -integer -index 0 $cells] {
            lassign $pair x inst
            set w [[$inst getMaster] getWidth]
            if {$prev_end ne "" && $x != $prev_end && [expr $x - $prev_end] < $min_gap} {
                $inst setLocation $prev_end $ry
                set x $prev_end
                incr moved
            }
            set prev_end [expr $x + $w]
        }
    }
    puts "FLOW: abut_rows moved $moved cells (min gap $min_gap_um um)"
}
abut_rows $::env(MIN_GAP)
check_placement -verbose
write_def $OUT/3_cts.def

# ---- Metal2 keep-out along the core's W/E edges (EDGE_M2_KEEPOUT um, default 6) ------------------
# assemble_chip.py joins W/E core pins (metal1) with a metal2 stub reaching 4.5 um into the core and a via down.
# Core metal2 routed along those edges would short to the stubs (seen: 9 nets on the E edge). Pins stay
# reachable on metal1 from inside.
set ko [expr {[info exists ::env(EDGE_M2_KEEPOUT)] ? $::env(EDGE_M2_KEEPOUT) : 6}]
if {$ko > 0} {
    set blk [ord::get_db_block]; set dbu [$blk getDbUnitsPerMicron]; set die [$blk getDieArea]
    set m2 [[[ord::get_db] getTech] findLayer metal2]; set k [expr round($ko * $dbu)]
    odb::dbObstruction_create $blk $m2 [$die xMin] [$die yMin] [expr [$die xMin] + $k] [$die yMax]
    odb::dbObstruction_create $blk $m2 [expr [$die xMax] - $k] [$die yMin] [$die xMax] [$die yMax]
    puts "FLOW: metal2 edge keep-out $ko um on W and E"
}
# Power legs: assemble_chip.py lands each VDD/VSS pad on its edge stripe with a 20 um wide metal2 leg reaching
# 22 um into the core on W and E. Keep core metal2 out of those zones (24 um deep, leg height + 1.7 um).
foreach yc [list $::env(VDD_Y) $::env(VSS_Y)] {
    set blk [ord::get_db_block]; set dbu [$blk getDbUnitsPerMicron]; set die [$blk getDieArea]
    set m2 [[[ord::get_db] getTech] findLayer metal2]
    set y1 [expr round(($yc - 11.7) * $dbu)]; set y2 [expr round(($yc + 11.7) * $dbu)]; set d [expr round(24 * $dbu)]
    odb::dbObstruction_create $blk $m2 [$die xMin] $y1 [expr [$die xMin] + $d] $y2
    odb::dbObstruction_create $blk $m2 [expr [$die xMax] - $d] $y1 [$die xMax] $y2
    puts "FLOW: metal2 power-leg keep-out at y=$yc (W and E, 24 um)"
}

# ---- via1 blockages from earlier DRC iterations: "x1 y1 x2 y2" per line ---------------------------
set nblk 0
set via1 [[[ord::get_db] getTech] findLayer via1]
set dbu [[ord::get_db_block] getDbUnitsPerMicron]
if {[file exists $::env(BLOCKAGES)]} {
    set fh [open $::env(BLOCKAGES)]
    while {[gets $fh line] >= 0} {
        # "x1 y1 x2 y2" = via1 blockage; "metal2 x1 y1 x2 y2" = blockage on that layer
        set lay $via1
        if {[llength $line] == 5} { set lay [[[ord::get_db] getTech] findLayer [lindex $line 0]]; set line [lrange $line 1 end] }
        if {[llength $line] != 4} continue
        lassign $line x1 y1 x2 y2
        odb::dbObstruction_create [ord::get_db_block] $lay [expr round($x1*$dbu)] [expr round($y1*$dbu)] [expr round($x2*$dbu)] [expr round($y2*$dbu)]
        incr nblk
    }
    close $fh
}
puts "FLOW: via1 blockages = $nblk"

# ---- Routing (2 metals) -----------------------------------------------------------------------
# GRT_ADJ (0..1) reserves that fraction of each layer's tracks in global routing, which spreads the guides
set_global_routing_layer_adjustment metal1 $::env(GRT_ADJ)
set_global_routing_layer_adjustment metal2 $::env(GRT_ADJ)
set_routing_layers -signal metal1-metal2 -clock metal1-metal2
global_route -allow_congestion -verbose
# VIA_IN_PIN=1 forces each via's whole metal pad inside the pin (SCL template, made for 2.5 um square
# pins). With the GDS-derived LEF (flow/gen_route_lef.py) pins are exact and the area around them is spacing-
# checked; some SCL pins are narrower than a via pad (OR4101 IN2: 2.4 um), so the default is off.
set vip [expr {[info exists ::env(VIA_IN_PIN)] && $::env(VIA_IN_PIN) == "1" ? "-via_in_pin_bottom_layer metal1 -via_in_pin_top_layer metal2" : ""}]
detailed_route -top_routing_layer metal2 {*}$vip \
    -output_drc $OUT/4_route_drc.rpt -droute_end_iter $::env(DRT_ITERS) -verbose 1
write_def $OUT/4_route.def
write_db  $OUT/4_route.odb
write_verilog -include_pwr_gnd $OUT/$::env(DESIGN)_pwr.v
write_verilog $OUT/$::env(DESIGN)_rt.v
puts "FLOW: done"
exit
